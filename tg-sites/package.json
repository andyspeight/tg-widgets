{
  "name": "tg-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "Travelgenix Sites. The CMS shell: content model, block library, renderer and editor.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalogue": "node tools/block-catalogue.mjs",
    "catalogue:check": "node tools/block-catalogue.mjs --check",
    "verify:browser": "node tools/build-standalone.mjs && node tools/build-theme-harness.mjs && node tools/verify-standalone.mjs && node tools/verify-theme.mjs && node tools/verify-settings.mjs && node tools/verify-motion.mjs && node tools/verify-motion-recipes.mjs && node tools/verify-motion-rail.mjs && node tools/verify-motion-video.mjs && node tools/verify-destination.mjs",
    "test:live": "TG_LIVE_FONTS=1 vitest run tests/fonts.live.test.ts",
    "perf": "node tools/build-perf-page.mjs && node tools/verify-perf.mjs",
    "perf:baseline": "node tools/build-perf-page.mjs && node tools/verify-perf.mjs --save-baseline"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@iconify-json/lucide": "1.2.121",
    "@vercel/blob": "^2.6.1",
    "next": "15.5.22",
    "parse5": "^7.3.0",
    "postcss": "^8.5.24",
    "postgres": "^3.4.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.24"
  }
}
