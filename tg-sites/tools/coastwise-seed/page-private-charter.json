        {
         "id": "b_ddxj4gbv",
         "type": "heading",
         "props": {
          "level": "h2",
          "html": "From first call to first cast-off",
          "align": "left"
         }
        },
        {
         "id": "b_depjet3a",
         "type": "steps",
         "props": {
          "layout": "down",
          "marker": "number",
          "connector": true,
          "items": [
           {
            "title": "The conversation",
            "body": "Half an hour with Fiona or one of the masters. Who is coming, what the week is for, and which coast fits the month you have in mind."
           },
           {
            "title": "The sketch",
            "body": "A route drawn on a real chart and photographed for you, with a price that is the price. Two revisions is normal. Seven is the record, and they were lovely about it."
           },
           {
            "title": "The hold",
            "body": "A provisional date holds for fourteen days with no card while you gather your people. The deposit is a fifth and sits in trust."
           },
           {
            "title": "The sail",
            "body": "The crew know every name before the gangway goes down. After that the plan belongs to you and the weather, in that order most days."
           }
          ]
         }
        }
       ]
      }
     ],
