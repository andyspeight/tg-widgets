       "blocks": [
        {
         "id": "b_9ul4jify",
         "type": "heading",
         "props": {
          "level": "h2",
          "html": "What you might see, and when",
          "align": "left"
         }
        },
        {
         "id": "b_9v5b8yh0",
         "type": "accordion",
         "props": {
          "style": "separated",
          "single": false,
          "openFirst": true,
          "textColour": "",
          "items": [
           {
            "title": "April and May",
            "body": "The cliffs fill. Puffins back on the ledges, gannets diving off Shetland, porpoise in every sound. The Hebrides at their busiest above the waterline."
           },
           {
            "title": "June and July",
            "body": "Whale months. Minke reliably, humpback increasingly, orca if the herring run inshore. Mykines at full strength, all million of it."
           },
           {
            "title": "August and September",
            "body": "Sea eagles teaching their young along the Norwegian arms, dolphins riding the bow most passages, and the first big rafts of shearwaters heading south."
           }
          ]
         }
        }
       ]
      }
     ],
     "gap": 32,
     "stackBelow": "mobile",
     "reverseOnStack": false
    }
   ]
  },
