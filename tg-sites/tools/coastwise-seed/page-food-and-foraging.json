         "type": "text",
         "props": {
          "html": "<p>There are no gourmet departures and no ordinary ones. This is how every sailing eats.</p>"
         }
        },
        {
         "id": "b_bxb88w2n",
         "type": "steps",
         "props": {
          "layout": "down",
          "marker": "number",
          "connector": true,
          "items": [
           {
            "title": "The quay, early",
            "body": "The chef is first down the gangway in every harbour. Langoustines at Tobermory, octopus at Vis, a cheese in Norway nobody can pronounce and everybody reorders."
           },
           {
            "title": "The galley, all day",
            "body": "One chef, one helper, eight tables. Bread proves while we sail. You will smell the day’s decision by eleven."
           },
           {
            "title": "The table, at eight",
            "body": "One sitting, no seating plan, the day’s catch and the day’s story. The wine list is short and right."
           }
          ]
         }
        }
       ]
