        {
         "id": "b_hdok2kqc",
         "type": "accordion",
         "props": {
          "style": "separated",
          "single": true,
          "openFirst": false,
          "textColour": "",
          "items": [
           {
            "title": "Can I hold a cabin while we decide?",
            "body": "Yes. A named cabin holds for seven days, no card required. Ring or WhatsApp and Fiona will do it while you are on the line."
           },
           {
            "title": "Do you take solo travellers?",
            "body": "Gladly. Sail solo on Freya or Skua and a double cabin is yours at a modest supplement, not a doubled fare. About a fifth of any sailing is travelling solo."
           },
           {
            "title": "What about reduced mobility?",
            "body": "Honestly, ship by ship: Nyren has a lift and two step-free cabins; Freya and Skua are ships of stairs. Tell us what you need and we will tell you plainly which ship fits."
           },
           {
            "title": "Is my money protected?",
            "body": "Yes. ABTA Y2841 for the sea, ATOL 11627 where we sell you the flight too. The deposit sits in trust until you sail."
           }
          ]
         }
        }
       ]
      }
