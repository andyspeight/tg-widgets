        {
         "id": "b_87vbic7y",
         "type": "steps",
         "props": {
          "layout": "down",
          "marker": "dot",
          "connector": true,
          "items": [
           {
            "title": "Eight",
            "body": "Sail with coffee on the rail. An hour of coast slides past before anyone is properly awake, which is the correct way to see it."
           },
           {
            "title": "Ten",
            "body": "Anchor in a bay with pine down to the water. The ladder goes down. The first swimmer sets the tone for the day."
           },
           {
            "title": "One",
            "body": "Mezze under the awning. The chef counts the plates back like a customs officer."
           },
           {
            "title": "Five",
            "body": "The ruin, in the late light after the coach parties have gone. A drowned harbour wall slides under the hull on the way."
           },
           {
            "title": "Eight",
            "body": "Dinner on deck or ashore. The sea is still warm. Somebody swims again and pretends it was for science."
           }
          ]
         }
        }
       ]
