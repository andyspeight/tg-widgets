{
  "manifest_version": 3,
  "name": "TG Slicer",
  "version": "0.6.0",
  "description": "Point at any component on any website, capture it clean, then send it to Travelgenix Sites.",
  "action": { "default_popup": "popup.html", "default_title": "TG Slicer" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://tg-sites-shell.vercel.app/*",
        "https://tg-sites-shell-agendasgroup.vercel.app/*",
        "https://tg-sites-shell-git-main-agendasgroup.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
