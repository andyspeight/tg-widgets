# Copy to .env.local for development. Never commit a filled-in copy.
# These are set in the Vercel project settings for production.

# --- Required now -------------------------------------------------------
# Upstash Redis, used for per-IP rate limiting on the public endpoint.
# Without these the limiter falls back to an in-memory window, which still
# works but is not shared between serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Comma-separated list of origins allowed to call /api/check
# cross-origin. Leave empty for same-origin only. Never set this to *.
ALLOWED_ORIGINS=

# --- Later phases, not used by the auditor ------------------------------
# Lead capture
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# Share-of-model tracker (paid layer)
# ANTHROPIC_API_KEY=

# Phase 3 remediation ONLY. Copy the values from the luna-marketing Vercel
# project. Never mint new Duda credentials. The auditor needs none of these.
# DUDA_API_USERNAME=
# DUDA_API_PASSWORD=
